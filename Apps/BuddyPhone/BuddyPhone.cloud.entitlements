<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- OPT-IN, signed device builds only. Never the default: iCloud entitlements are restricted and need a
	     provisioning profile for App ID com.sergeyhovakimyan.buddy.phone (iCloud + CloudKit with the container below, Push
	     Notifications). Select with
	       xcodebuild ... BUDDY_ENTITLEMENTS=BuddyPhone/BuddyPhone.cloud.entitlements DEVELOPMENT_TEAM=<your team id> \
	         CODE_SIGN_IDENTITY="Apple Development" -allowProvisioningUpdates
	     See docs/cloudkit-setup.md. Xcode adds application-identifier and team-identifier from the profile. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.sergeyhovakimyan.buddy</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Push (approval alerts and CloudKit sync pushes). Xcode rewrites the value to "production" for
	     App Store / TestFlight distribution signing. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
