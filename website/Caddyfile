{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	# /privacy and /support work as well as /privacy.html and /support.html (App Store Connect links to them).
	try_files {path} {path}.html
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Only the site's own scripts (script.js, block.js) and Cloudflare's Web Analytics beacon (described in
		# privacy.html) run. A new analytics or other script host must be added here and to the privacy policy together.
		Content-Security-Policy "script-src 'self' https://static.cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}
	# Pages, styles and scripts keep their names between releases, so browsers and Cloudflare must check for a new
	# version (cheap, with the ETag) instead of keeping the old one for hours. Images change rarely.
	@images path *.png *.svg
	header @images Cache-Control "public, max-age=86400"
	header ?Cache-Control "no-cache"
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
