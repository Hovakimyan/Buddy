{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	# /privacy and /support work as well as /privacy.html and /support.html (App Store Connect links to them).
	try_files {path} {path}.html
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Only the site's own script.js runs. This also keeps scripts a proxy might inject (Cloudflare's Web Analytics
		# beacon) from running, so "no analytics" in privacy.html stays true.
		Content-Security-Policy "script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
	}
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
